{
  "manifest_version": 3,
  "name": "Y Supplier Clipboard",
  "version": "2.7.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "activeTab", "scripting", "offscreen", "clipboardWrite", "downloads"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "copy-product": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "__MSG_copyProduct__"
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Y Supplier Clipboard",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["ui/i18n.js", "core/formatter.js", "core/parser.js", "storage/profiles.js", "storage/work-styles.js", "ui/element-picker.js", "content.js"],
    "css": ["ui/configurator.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["ui/*", "icons/icon-32.png"], "matches": ["<all_urls>"] }]
}
